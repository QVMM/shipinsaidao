PORT=4173
HOST=0.0.0.0
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=data/tihua.db
SEAL_SECRET=
# 1 = 强制离线运行，核心业务、本地证据问答与系统语音照常运行
OFFLINE_MODE=1
# 可选：仅用于 MiMo 语音合成；问答与业务判定始终在本地完成
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 舞台展台令牌（仅服务端；勿写进前端；生产请换成长随机串）
# 若未设置，只要 SESSION_SECRET 可用，仍会签发 httpOnly 展台 cookie
DJTK_STAGE_TOKEN=change-me
