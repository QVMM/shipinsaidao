PORT=4173
HOST=0.0.0.0
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=data/tihua.db
SEAL_SECRET=
# 1 = 强制离线运行，核心业务、本地证据问答与系统语音照常运行
OFFLINE_MODE=1
# 比赛离线语音：模型默认安装在项目 models/offline 目录
OFFLINE_MODEL_DIR=models/offline
OFFLINE_VOICE_SPEED=1.04
# 默认 zipvoice（自然女声）；仅在应急时可改为 matcha
OFFLINE_VOICE_ENGINE=zipvoice
OFFLINE_ASR_THREADS=4
OFFLINE_TTS_THREADS=4
# 舞台展台令牌（仅服务端；勿写进前端；生产请换成长随机串）
# 若未设置，只要 SESSION_SECRET 可用，仍会签发 httpOnly 展台 cookie
DJTK_STAGE_TOKEN=change-me
