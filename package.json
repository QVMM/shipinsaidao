{
  "name": "tihua-offline-competition",
  "private": true,
  "version": "1.0.0",
  "description": "替抗蓟化全链条质控与溯源平台完全离线竞赛版",
  "author": "DJTK 项目组",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node server/dev.js",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "offline": "node server/offline-start.js",
    "offline:models": "node scripts/install-offline-models.mjs",
    "offline:verify-models": "node scripts/install-offline-models.mjs --verify-only",
    "offline:check": "node scripts/offline-self-check.mjs",
    "offline:smoke": "node scripts/voice-smoke.mjs",
    "offline:verify-win-package": "node scripts/verify-windows-package.mjs",
    "web:dist:win": "node scripts/build-windows-web.mjs && node scripts/verify-windows-web-package.mjs",
    "web:verify:win": "node scripts/verify-windows-web-package.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg zip",
    "desktop:dist:win": "node scripts/prepare-windows-voice-runtime.mjs && npm run build && electron-builder --win nsis portable --x64",
    "preview": "node server/index.js",
    "seed": "node server/seed.js",
    "lint": "eslint src server desktop scripts test e2e playwright.config.js",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:all": "npm run lint && npm run test:unit && npm run build && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "2.4.3",
    "echarts": "^6.1.0",
    "fastify": "^5.12.5",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "archiver": "^8.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "22.x"
  },
  "build": {
    "appId": "cn.djtk.tihua.offline",
    "productName": "替抗蓟化离线竞赛版",
    "asar": true,
    "npmRebuild": false,
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "server/**/*",
      "src/**/*",
      "package.json",
      "!node_modules/sherpa-onnx-darwin-*/**/*",
      "!node_modules/sherpa-onnx-linux-*/**/*",
      "!node_modules/sherpa-onnx-win-ia32/**/*"
    ],
    "extraResources": [
      {
        "from": "models/offline",
        "to": "models/offline",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-*/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于离线识别现场讲解员的语音问题，录音不会上传网络。"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "optionalDependencies": {
    "sherpa-onnx-win-x64": "^1.13.8"
  }
}
